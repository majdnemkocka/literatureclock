    { "id": "kedd", "name": "Kedd", "terms": ["kedd*", "keddi*"], "dow": "TUESDAY", "dow_num": 2 },
    { "id": "szerda", "name": "Szerda", "terms": ["szerda*", "szerdai*"], "dow": "WEDNESDAY", "dow_num": 3 },
