    { "term": "húsvét*", "dow": "SUNDAY", "dow_num": 7, "date_min": "03-22", "date_max": "04-25", "date_focus": "04-07" },
    { "term": "pünkösd*", "dow": "SUNDAY", "dow_num": 7, "date_min": "05-10", "date_max": "06-15", "date_focus": "05-25" },
