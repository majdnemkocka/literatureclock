{
  "locale": "hu",
  "version": 2,
  "strict": false,
  "notes": [
    "Search terms and extraction rules for literary date extraction from MEK fulltext search.",
    "Supports exact dates (MM-DD), month parts (elején/közepén/végén), seasons, holidays, and weekdays.",
    "Suffix truncation (*) is used in queries to match inflected forms."
  ],
  "months": [
    { "num": 1, "name": "január", "max_days": 31, "forms": ["január*", "januar*", "jan."] },
    { "num": 2, "name": "február", "max_days": 29, "forms": ["február*", "februar*", "febr.", "feb."] },
    { "num": 3, "name": "március", "max_days": 31, "forms": ["március*", "marcius*", "márc.", "marc.", "márc", "marc"] },
    { "num": 4, "name": "április", "max_days": 30, "forms": ["április*", "aprilis*", "ápr.", "apr.", "ápr", "apr"] },
    { "num": 5, "name": "május", "max_days": 31, "forms": ["május*", "majus*", "máj.", "maj.", "máj", "maj"] },
    { "num": 6, "name": "június", "max_days": 30, "forms": ["június*", "junius*", "jún.", "jun.", "jún", "jun"] },
    { "num": 7, "name": "július", "max_days": 31, "forms": ["július*", "julius*", "júl.", "jul.", "júl", "jul"] },
    { "num": 8, "name": "augusztus", "max_days": 31, "forms": ["augusztus*", "aug.", "aug"] },
    { "num": 9, "name": "szeptember", "max_days": 30, "forms": ["szeptember*", "szept.", "szept", "szep.", "szep"] },
    { "num": 10, "name": "október", "max_days": 31, "forms": ["október*", "oktober*", "okt.", "okt"] },
    { "num": 11, "name": "november", "max_days": 30, "forms": ["november*", "nov.", "nov"] },
    { "num": 12, "name": "december", "max_days": 31, "forms": ["december*", "dec.", "dec"] }
  ],
  "day_suffixes": [".", "-án", "-én", "-n", "-ai", "-ei", ""],
  "month_parts": [
    { "part": "start", "suffix_forms": ["elején", "eleje", "első napjaiban", "első felében"], "offset_min": 1, "offset_max": 10, "offset_focus": 5 },
    { "part": "mid", "suffix_forms": ["közepén", "közepe", "derekán", "dereka", "táján"], "offset_min": 10, "offset_max": 20, "offset_focus": 15 },
    { "part": "end", "suffix_forms": ["végén", "vége", "utolsó napjaiban", "utolsó felében"], "offset_min": 20, "offset_max": "max", "offset_focus": 28 }
  ],
  "seasons": [
    { "id": "tavasz", "name": "Tavasz", "terms": ["tavasz*", "tavaszelő*", "kora tavasz*", "tavaszi*"], "date_min": "03-01", "date_max": "05-31", "date_focus": "04-15" },
    { "id": "nyar", "name": "Nyár", "terms": ["nyár*", "nyáron*", "nyárutó*", "kora nyár*", "kánikula*", "nyári*"], "date_min": "06-01", "date_max": "08-31", "date_focus": "07-15" },
    { "id": "osz", "name": "Ősz", "terms": ["ősz*", "ősszel*", "őszutó*", "kora ősz*", "vénasszonyok nyar*", "őszi*"], "date_min": "09-01", "date_max": "11-30", "date_focus": "10-15" },
    { "id": "tel", "name": "Tél", "terms": ["tél*", "télen*", "télvíz*", "kora tél*", "téli*"], "date_min": "12-01", "date_max": "02-28", "date_focus": "01-15" }
  ],
  "weekdays": [
