{
  "locale": "hu",
  "version": 1,
  "strict": true,
  "notes": [
    "Strict mode: emit ONLY exact minutes. Dayparts are used ONLY to disambiguate 12h, never emitted alone.",
    "Order matters; earlier rules win ties."
  ],
  "rules": [
    {
      "id": "clock_hh_mm_colon",
      "description": "24h with colon (07:05, 19:05).",
      "type": "regex",
      "pattern": "(?<!\\d)\\b([01]?\\d|2[0-3]):([0-5]\\d)\\b(?!\\d)",
      "semantics": "clock_hh_mm"
    },
    {
      "id": "clock_hh_mm_dot",
      "description": "24h with dot (7.05, 07.05, 19.05).",
      "type": "regex",
      "pattern": "(?<!\\d)\\b([01]?\\d|2[0-3])\\.([0-5]\\d)\\b(?!\\d)",
      "semantics": "clock_hh_mm"
    },
    //    TODO is this working?
    {
      "id": "x_ora_y_perc_digits",
      "description": "X óra Y perc / perckor (24h digits).",
      "type": "regex",
      "pattern": "\\b([01]?\\d|2[0-3])\\s*óra\\s*([0-5]?\\d)\\s*perc(?:kor|ben)?\\b",
      "semantics": "clock_hh_mm"
    },
    {
      "id": "x_ora_y_perc_words",
      "description": "X óra Y perc (X and/or Y in words).",
      "type": "regex",
      "pattern": "\\b(egy|kettő|két|három|négy|öt|hat|hét|nyolc|kilenc|tíz|tizenegy|tizenkettő|tizen\\w+|huszon\\w+|húsz|harminc\\w*|negyven\\w*|ötven\\w*)\\s*óra\\s*(?:([0-5]?\\d)|([a-záéíóöőúüű\\-]+))\\s*perc(?:kor|ben)?\\b",
      "semantics": "clock_words_maybe_digits"
    },
    {
      "id": "oclock_strict_24h",
      "description": "X óra / X-kor / X órakor (digits, 0–23 only).",
      "type": "regex",
      "pattern": "(?<!\\bfél\\s)(?<!\\bfel\\s)(?<!\\bnegyed\\s)(?<!\\bháromnegyed\\s)(?<!\\bharomnegyed\\s)\\b([01]?\\d|2[0-3])\\s*(?:óra|órakor|-?kor)\\b",
      "semantics": "oclock_h"
    },
    {
      "id": "relative_fel",
      "description": "fél N → (N-1):30",
      "type": "regex",
      "pattern": "\\bf[ée]l\\s*(1[0-2]|0?[1-9]|tizenegy|tizenkettő|egy|kettő|két|három|négy|öt|hat|hét|nyolc|kilenc|tíz)(?:-?kor)?\\b",
      "semantics": "half_next_hour"
    },
    {
      "id": "relative_negyed",
      "description": "negyed N → (N-1):15",
      "type": "regex",
      "pattern": "\\bnegyed\\s*(1[0-2]|0?[1-9]|tizenegy|tizenkettő|egy|kettő|két|három|négy|öt|hat|hét|nyolc|kilenc|tíz)(?:-?kor)?\\b",
      "semantics": "quarter_next_hour"
    },
    {
      "id": "relative_haromnegyed",
      "description": "háromnegyed N → (N-1):45",
      "type": "regex",
      "pattern": "\\bh[aá]romnegyed\\s*(1[0-2]|0?[1-9]|tizenegy|tizenkettő|egy|kettő|két|három|négy|öt|hat|hét|nyolc|kilenc|tíz)(?:-?kor)?\\b",
      "semantics": "threequarter_next_hour"
    },
    {
      "id": "after_minutes",
      "description": "Y perc(cel) X óra után / X óra után Y perc(cel) → X:Y",
      "type": "regex",
      "pattern": "\\b(?:(?:([0-5]?\\d)|([a-záéíóöőúüű\\-]+))\\s*percc?el\\s*(?:[a ]*)?([01]?\\d|2[0-3])\\s*óra\\s*után|([01]?\\d|2[0-3])\\s*óra\\s*után\\s*(?:([0-5]?\\d)|([a-záéíóöőúüű\\-]+))\\s*percc?el)\\b",
      "semantics": "after_minutes"
    },
    {
      "id": "before_minutes",
      "description": "Y perc(cel) X óra előtt / X óra előtt Y perc(cel) → (X-1):(60-Y)",
      "type": "regex",
      "pattern": "\\b(?:(?:([0-5]?\\d)|([a-záéíóöőúüű\\-]+))\\s*percc?el\\s*(?:[a ]*)?([01]?\\d|2[0-3])\\s*óra\\s*előtt|([01]?\\d|2[0-3])\\s*óra\\s*előtt\\s*(?:([0-5]?\\d)|([a-záéíóöőúüű\\-]+))\\s*percc?el)\\b",
      "semantics": "before_minutes"
    },
    {
      "id": "oclock_words_with_daypart",
      "description": "word + óra/órakor with daypart bias (we keep ambiguous if no daypart).",
      "type": "regex",
      "pattern": "(?<!\\bfél\\s)(?<!\\bfel\\s)(?<!\\bnegyed\\s)(?<!\\bháromnegyed\\s)(?<!\\bharomnegyed\\s)\\b(egy|kettő|két|három|négy|öt|hat|hét|nyolc|kilenc|tíz|tizenegy|tizenkettő)\\s*(?:óra|órakor|-?kor)\\b",
      "semantics": "oclock_word_needs_daypart"
    },
    {
      "id": "bare_daypart",
      "description": "Dayparts exist but NEVER emitted in strict mode; used only to bias 12h resolution.",
      "type": "regex",
      "pattern": "\\b(hajnalban|hajnal|reggel|délelőtt|dél|délután|este|éjjel|éjfél|de\\.|du\\.)\\b",
      "semantics": "daypart_for_bias"
    }
  ],
  "word2hour": {
    "egy": 1,
    "kettő": 2,
    "két": 2,
    "három": 3,
    "négy": 4,
    "öt": 5,
    "hat": 6,
    "hét": 7,
    "nyolc": 8,
    "kilenc": 9,
    "tíz": 10,
    "tizenegy": 11,
    "tizenkettő": 12
  },
  "number_words": {
    "0": [
      "nulla",
      "zéró"
    ],
    "1": [
      "egy"
    ],
    "2": [
      "kettő",
      "két"
    ],
    "3": [
      "három"
    ],
    "4": [
      "négy"
    ],
    "5": [
      "öt"
    ],
    "6": [
      "hat"
    ],
    "7": [
      "hét"
    ],
    "8": [
      "nyolc"
    ],
    "9": [
      "kilenc"
    ],
    "10": [
      "tíz"
    ],
    "11": [
      "tizenegy"
    ],
    "12": [
      "tizenkettő"
    ],
    "13_19_prefix": [
      "tizen"
    ],
    "20_exact": [
      "húsz"
    ],
    "20s_prefix": [
      "huszon"
    ],
    "30_exact": [
      "harminc"
    ],
    "30s_prefix": [
      "harminc"
    ],
    "40_exact": [
      "negyven"
    ],
    "40s_prefix": [
      "negyven"
    ],
    "50_exact": [
      "ötven"
    ],
    "50s_prefix": [
      "ötven"
    ]
  },
  "daypart_rules": [
    {
      "id": "daypart_hajnal",
      "pattern": "\\b(?:kora\\s+)?(?:hajnal(?:ban|i)?|pirkadat(?:kor)?|napkelte(?:kor)?|pitymallat(?:kor)?)\\b",
      "time_min": "04:00",
      "time_max": "07:00",
      "time_focus": "05:30",
      "description": "Hajnal / pirkadat"
    },
    {
      "id": "daypart_reggel",
      "pattern": "\\b(?:kora\\s+)?reggel(?:i|ente|kor)?\\b",
      "time_min": "06:00",
      "time_max": "09:30",
      "time_focus": "07:30",
      "description": "Reggel"
    },
    {
      "id": "daypart_delelott",
      "pattern": "\\bdélelőtt(?:önként|i)?\\b",
      "time_min": "09:00",
      "time_max": "12:00",
      "time_focus": "10:30",
      "description": "Délelőtt"
    },
    {
      "id": "daypart_del",
      "pattern": "\\b(?:délben|dél\\s+tájban|dél\\s+körül|déli\\s+harangszó(?:kor)?)\\b",
      "time_min": "11:30",
      "time_max": "12:30",
      "time_focus": "12:00",
      "description": "Délben / dél körül"
    },
    {
      "id": "daypart_kora_delutan",
      "pattern": "\\bkora\\s+délután(?:i)?\\b",
      "time_min": "12:30",
      "time_max": "14:30",
      "time_focus": "13:30",
      "description": "Kora délután"
    },
    {
      "id": "daypart_delutan",
      "pattern": "\\bdélután(?:onként|i)?\\b",
      "time_min": "13:00",
      "time_max": "18:00",
      "time_focus": "15:30",
      "description": "Délután"
    },
    {
      "id": "daypart_keso_delutan_alkonyat",
      "pattern": "\\b(?:késő\\s+délután(?:i)?|alkonyat(?:kor)?|szürkület(?:kor)?|napnyugta(?:kor)?|naplemente(?:kor)?)\\b",
      "time_min": "16:30",
      "time_max": "19:00",
      "time_focus": "17:45",
      "description": "Késő délután / alkonyat / szürkület"
    },
    {
      "id": "daypart_kora_este",
      "pattern": "\\bkora\\s+este(?:i)?\\b",
      "time_min": "18:00",
      "time_max": "20:00",
      "time_focus": "19:00",
      "description": "Kora este"
    },
    {
      "id": "daypart_este",
      "pattern": "\\b(?:este(?:i|nként)?|esteled(?:ik|ett|vén))\\b",
      "time_min": "18:30",
      "time_max": "22:00",
      "time_focus": "20:00",
      "description": "Este"
    },
    {
      "id": "daypart_keso_este",
      "pattern": "\\bkéső\\s+este(?:i)?\\b",
      "time_min": "21:30",
      "time_max": "23:30",
      "time_focus": "22:30",
      "description": "Késő este"
    },
    {
      "id": "daypart_ejfel_korul",
      "pattern": "\\béjfél\\s+(?:tájban|körül|után|előtt)\\b",
      "time_min": "23:30",
      "time_max": "24:30",
      "time_focus": "24:00",
      "description": "Éjfél tájban / körül"
    },
    {
      "id": "daypart_ejjel",
      "pattern": "\\b(?:éjjel(?:i|ente)?|éjszaka(?:i)?)\\b",
      "time_min": "22:00",
      "time_max": "26:00",
      "time_focus": "24:00",
      "description": "Éjjel / éjszaka"
    }
  ]
}
